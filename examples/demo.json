        {
          "on": "three slide types",
          "action": "walk_to",
          "x": "N",
          "face": "slide"
        },
        {
          "on": "a title card",
          "action": "point_slide",
          "target": "word:title",
          "hold": 0.8
        },
        {
          "on": "a list",
          "action": "point_slide",
          "target": "word:bullets",
          "hold": 0.8
        },
        {
          "on": "a big highlight",
          "action": "point_slide",
          "target": "word:highlight",
          "hold": 1.0
        },
        {
          "on": "Mix them",
          "action": "walk_to",
          "x": "H",
          "face": "camera"
        },
        {
          "on": "tell your story",
          "action": "explain_open",
          "face": "camera",
          "hold": 1.2
        }
      ],
      "emph": [
        {
          "on": "title card",
          "target": "word:title",
          "style": "mark"
        },
        {
          "on": "list",
          "target": "word:bullets",
          "style": "mark"
        },
        {
          "on": "big highlight",
          "target": "word:highlight",
          "style": "mark"
