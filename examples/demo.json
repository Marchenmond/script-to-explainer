  "scenes": [
    {
      "lead": 1.8,
      "say": "Hi... I'm Bit. Today I'll show you how to turn a script... into an explainer video!",
      "emotion": "happy",
      "camera": [
        {
          "on": "start",
          "view": "wide"
        },
        {
          "on": "Hi",
          "view": "bit",
          "zoom": 1.04
        },
        {
          "on": "Today",
          "view": "wide"
        }
      ],
      "cues": [
        {
          "on": "start",
          "action": "enter",
          "from": "off",
          "x": "R",
          "face": "camera"
        },
        {
          "on": "Hi",
          "action": "wave",
          "face": "camera",
          "hold": 1.3
        },
        {
          "on": "Today",
          "action": "walk_to",
          "x": "H",
          "face": "camera"
        },
        {
          "on": "explainer video",
          "action": "point_slide",
          "face": "slide",
          "target": "title",
          "hold": 1.3
        }
      ],
      "emph": [
        {
          "on": "script",
          "target": "title",
          "style": "mark"
        },
        {
          "on": "explainer video",
          "target": "title",
          "style": "pop"
        }
      ],
      "slide": {
        "type": "title",
        "kicker": "script-to-explainer",
        "title": "Script in,\nvideo out",
        "subtitle": "One JSON file. One command."
      }
    },
    {
      "say": "You write a short script. Each scene has the words I say, a slide, and how I feel about it.",
      "emotion": "neutral",
      "camera": [
        {
          "on": "You write",
          "view": "wide"
        },
        {
          "on": "Each scene",
          "view": "slide"
        }
      ],
      "cues": [
        {
          "on": "You write",
          "action": "explain_open",
          "face": "camera",
          "hold": 1.0
        },
        {
          "on": "short script",
          "action": "walk_to",
          "x": "N",
          "face": "slide"
        },
        {
          "on": "words I say",
          "action": "point_slide",
          "target": "item:0",
          "hold": 0.9
        },
        {
          "on": "a slide",
          "action": "point_slide",
          "target": "item:1",
          "hold": 0.9
        },
        {
          "on": "how I feel",
          "action": "shrug",
          "face": "slide",
          "target": "item:2",
          "hold": 0.9
        }
      ],
      "emph": [
        {
          "on": "words",
          "target": "item:0",
          "style": "mark"
        },
        {
          "on": "slide",
          "target": "item:1",
          "style": "mark"
        },
        {
          "on": "feel",
          "target": "item:2",
          "style": "mark"
        }
      ],
      "reveal": [
        {
          "item": 0,
          "on": "the words I say"
        },
        {
          "item": 1,
          "on": "a slide"
        },
        {
          "item": 2,
          "on": "how I feel"
        }
      ],
      "slide": {
        "type": "bullets",
        "title": "A scene is simple",
        "items": [
          "The narration",
          "A slide to show",
          "My mood: neutral, happy, thinking or pointing"
        ]
      }
    },
    {
      "say": "Then you run ONE command. The voice is generated locally, so nothing... leaves your machine!",
      "emotion": "neutral",
      "camera": [
        {
          "on": "one command",
          "view": "slide"
        },
        {
          "on": "nothing leaves",
          "view": "wide"
        }
      ],
      "cues": [
        {
          "on": "one command",
          "action": "point_slide",
          "face": "slide",
          "target": "highlight",
          "hold": 1.3
        },
        {
          "on": "generated locally",
          "action": "look_slide",
          "face": "slide",
          "hold": 1.0
        },
        {
          "on": "nothing",
          "action": "walk_to",
          "x": "M",
          "face": "camera"
        },
        {
          "on": "your machine",
          "action": "shrug",
          "face": "camera",
          "hold": 0.9
        }
      ],
      "emph": [
        {
          "on": "one command",
          "target": "highlight",
          "style": "mark"
        },
        {
          "on": "locally",
          "target": "subtitle",
          "style": "pop"
        }
      ],
      "slide": {
        "type": "highlight",
        "title": "Render it",
        "highlight": "python -m explainer render demo.json",
        "subtitle": "Local voice. No cloud needed."
      }
    },
    {
      "say": "Captions are timed to the narration, and my mouth follows the voice. Not bad for a little robot.",
      "emotion": "happy",
      "camera": [
        {
          "on": "Captions",
          "view": "caption"
        },
        {
          "on": "Not bad",
          "view": "bit"
        }
      ],
      "cues": [
        {
          "on": "Captions",
          "action": "point_down",
          "face": "camera",
          "hold": 1.2
        },
        {
          "on": "my mouth",
          "action": "walk_to",
          "x": "H",
          "face": "camera"
        },
        {
          "on": "Not bad",
          "action": "celebrate",
          "face": "camera",
          "hold": 1.3
        }
      ],
      "reveal": [
        {
          "item": 0,
          "on": "Captions"
        },
        {
          "item": 1,
          "on": "my mouth"
        },
        {
          "item": 2,
          "on": "Not bad"
        }
