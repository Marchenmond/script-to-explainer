  "pauses": {
    "comma": 0.2,
    "semicolon": 0.25,
    "colon": 0.25,
    "dash": 0.25,
    "ellipsis": 0.5,
    "period": 0.45,
    "question": 0.45,
    "exclaim": 0.5
  },
  "direction": {
    "anticipation_ms": 200,
    "min_gap_ms": 1500,
    "max_hold_same_pose_s": 3.5,
    "auto_rules": true
  }
