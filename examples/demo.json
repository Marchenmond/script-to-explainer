      "emph": [
        {
          "on": "Kokoro",
          "target": "item:0",
          "style": "mark"
        },
        {
          "on": "Azure Speech",
          "target": "item:1",
          "style": "mark"
        }
      ],
      "reveal": [
        {
          "item": 0,
          "on": "Kokoro"
