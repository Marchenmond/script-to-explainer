    {
      "say": "Want a different voice? The speech engine is swappable. Kokoro runs offline, and Azure Speech is optional.",
      "emotion": "thinking",
      "camera": [
        {
          "on": "Want a different",
          "view": "wide"
        },
        {
          "on": "Kokoro",
          "view": "slide"
        }
      ],
      "cues": [
        {
          "on": "Want a different",
          "action": "think_chin",
          "face": "camera",
          "hold": 1.6
        },
        {
          "on": "swappable",
          "action": "look_slide",
          "face": "slide",
          "hold": 1.0
        },
        {
          "on": "Kokoro",
          "action": "point_slide",
          "target": "item:0",
          "hold": 1.0
